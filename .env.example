# Postgres connection used by the app (Neon pooled URL, or Vercel Postgres).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/picktrinkets?sslmode=require"

# Direct connection for Prisma migrations. Use the non-pooled Neon URL.
# If your host only gives one URL, set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/picktrinkets?sslmode=require"

# Single password for /admin. There is no username.
ADMIN_PASSWORD="change-me"

# Optional. Public site URL used for metadata. Example: https://pick-trinkets.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional. When set, new product photos upload to Vercel Blob.
# When empty, photos are resized and stored as data URLs in Postgres (works on Vercel without Blob).
BLOB_READ_WRITE_TOKEN=""
